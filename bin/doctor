#!/usr/bin/env bash
set -u

failures=0

check_ok() {
  printf '[ok] %s\n' "$1"
}

check_warn() {
  printf '[warn] %s\n' "$1"
}

check_fail() {
  printf '[fail] %s\n' "$1"
  failures=$((failures + 1))
}

for tool in cmux starship lazygit fzf zoxide; do
  if command -v "$tool" >/dev/null 2>&1; then
    check_ok "$tool is installed"
  else
    check_fail "$tool is missing from PATH (run: brew bundle --file Brewfile)"
  fi
done

if [[ -n "${DOTFILES_BIN_DIR:-}" ]]; then
  case ":$PATH:" in
    *":$DOTFILES_BIN_DIR:"*) check_ok "dotfiles bin directory is on PATH" ;;
    *) check_fail "DOTFILES_BIN_DIR is set but not on PATH" ;;
  esac
else
  check_warn "DOTFILES_BIN_DIR is not set in this shell"
fi

if (( failures > 0 )); then
  printf '\nDoctor found %d issue(s).\n' "$failures"
  exit 1
fi

printf '\nDoctor checks passed.\n'

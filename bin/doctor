#!/usr/bin/env bash
set -u

failures=0

check_ok() {
  printf '[ok] %s\n' "$1"
}

check_warn() {
  printf '[warn] %s\n' "$1"
}

check_fail() {
  printf '[fail] %s\n' "$1"
  failures=$((failures + 1))
}

if command -v cmux >/dev/null 2>&1; then
  check_ok "cmux is installed"
else
  check_fail "cmux is missing from PATH"
fi

if command -v btop >/dev/null 2>&1; then
  check_ok "local btop is installed"
else
  check_warn "local btop is not in PATH"
fi

if [[ -n "${DOTFILES_BIN_DIR:-}" ]]; then
  case ":$PATH:" in
    *":$DOTFILES_BIN_DIR:"*) check_ok "dotfiles bin directory is on PATH" ;;
    *) check_fail "DOTFILES_BIN_DIR is set but not on PATH" ;;
  esac
else
  check_warn "DOTFILES_BIN_DIR is not set in this shell"
fi

if (( failures > 0 )); then
  printf '\nDoctor found %d issue(s).\n' "$failures"
  exit 1
fi

printf '\nDoctor checks passed.\n'


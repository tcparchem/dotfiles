# Machine-local SSH hosts. Copy to ~/.ssh/config.local and fill in your values.
# The mmini, mmon, mmlan, and mini helpers expect the aliases below.

Host macmini
  HostName your-mac.your-tailnet.ts.net
  User your-username
  IdentityFile ~/.ssh/id_ed25519_macmini
  IdentitiesOnly yes

Host macmini-lan
  HostName 192.168.1.50
  User your-username
  IdentityFile ~/.ssh/id_ed25519_macmini
  IdentitiesOnly yes
